{
  "$schema": "https://biomejs.dev/schemas/2.0.0-alpha.2/schema.json",
  "name": "sagaproteinsportessen",
  "version": "0.1.0",
  "language": {
    "javascript": {
      "formatter": {
        "style": {
          "lineWidth": 100,
          "semicolons": "error",
          "quotation": "doubleQuote",
          "indentation": "space"
        },
        "source": {
          "organizeImports": "error"
        }
      }
    },
    "typescript": {
      "formatter": {
        "style": {
          "lineWidth": 100,
          "semicolons": "error",
          "quotation": "doubleQuote",
          "indentation": "space"
        }
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": "warn",
      "nursery": "warn",
      "correctness": "error",
      "performance": "warn",
      "style": "warn"
    }
  },
  "formatter": {
    "enabled": true,
    "files": {
      "includes": ["src/**/*.{ts,tsx,js,mjs,json}"]
    }
  },
  "javascript": {
    "formatter": {
      "embed": {
        "css": true,
        "javascript": true,
        "markdown:markdown": true
      }
    }
  }
}
