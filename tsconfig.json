{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOMIterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentFormData": true,
    "noImplicitAny": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "unstable_bundledJsonImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/components": ["./src/components"],
      "@/pages": ["./src/pages"],
      "@/hooks": ["./src/hooks"],
      "@/lib": ["./src/lib"],
      "@/types": ["./src/types"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "public/build", "tests"]
}
